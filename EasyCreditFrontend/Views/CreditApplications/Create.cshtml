@model CreateApplicationViewModel
@{
    ViewData["Title"] = "Ajukan Kredit Baru";
}

<div class="page-head">
    <div>
        <div class="crumbs">
            <a asp-controller="Home" asp-action="Index">Dashboard</a>
            <span>/</span>
            <a asp-action="Index">Pengajuan Kredit</a>
            <span>/</span>
            <span>Baru</span>
        </div>
        <h2>Buat Pengajuan Kredit</h2>
        <p class="text-muted">
            Pilih nasabah, masukkan nominal pinjaman, pilih tenor, lalu lakukan simulasi cicilan sebelum menyimpan.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="panel p-4 mb-4">
            <h4 class="mb-3">Formulir Pengajuan</h4>
            <form asp-action="Create" method="post" id="formApplication">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CustomerId" class="form-label">Nasabah (Customer)</label>
                    <select asp-for="CustomerId" class="form-select" id="selectCustomer">
                        <option value="">-- Pilih Nasabah --</option>
                        @foreach (var cust in Model.AvailableCustomers)
                        {
                            <option value="@cust.CustomerId">@cust.Name (NIK: @cust.Nik)</option>
                        }
                    </select>
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LoanAmount" class="form-label">Jumlah Pinjaman (Rp)</label>
                    <input asp-for="LoanAmount" class="form-control" type="number" min="1000000" max="50000000" step="500000" id="inputLoanAmount" />
                    <small class="text-muted d-block mt-1">Minimal Rp 1.000.000, Maksimal Rp 50.000.000</small>
                    <span asp-validation-for="LoanAmount" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="TenorMonths" class="form-label">Tenor Pinjaman</label>
                    <select asp-for="TenorMonths" class="form-select" id="selectTenor">
                        <option value="6">6 Bulan</option>
                        <option value="12" selected>12 Bulan</option>
                        <option value="24">24 Bulan</option>
                        <option value="36">36 Bulan</option>
                    </select>
                    <span asp-validation-for="TenorMonths" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-dark" id="btnPreview">
                        ⌕ Hitung Cicilan (Simulasi)
                    </button>
                    <button type="submit" class="btn btn-accent" id="btnSubmit">
                        Simpan Pengajuan
                    </button>
                    <a asp-action="Index" class="btn btn-light">Batal</a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="panel p-4 mb-4">
            <h4 class="mb-3">Hasil Simulasi Cicilan</h4>
            <div id="previewEmptyState" class="text-center py-5 text-muted">
                <div style="font-size: 2rem;">🗓</div>
                <p class="mt-2">Klik tombol <strong>Hitung Cicilan</strong> untuk melihat simulasi jadwal dan nominal cicilan bulanan.</p>
            </div>

            <div id="previewLoading" class="text-center py-5 d-none">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted">Menghitung cicilan via Oracle Stored Procedure...</p>
            </div>

            <div id="previewTableContainer" class="d-none">
                <div class="alert alert-info py-2 px-3 mb-3">
                    <span id="previewSummary">Simulasi berhasil dihitung</span>
                </div>
                <div class="table-wrap">
                    <table class="data-table" id="tablePreview">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Jatuh Tempo</th>
                                <th class="text-end">Jumlah Cicilan</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="previewTbody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            var previewUrl = '@Url.Action("PreviewInstallment", "CreditApplications")';

            $('#btnPreview').on('click', function () {
                var loanAmount = parseFloat($('#inputLoanAmount').val());
                var tenor = parseInt($('#selectTenor').val());

                if (isNaN(loanAmount) || loanAmount < 1000000 || loanAmount > 50000000) {
                    EC.toast('error', 'Jumlah pinjaman harus antara Rp 1.000.000 dan Rp 50.000.000', 'Validasi Gagal');
                    return;
                }

                $('#previewEmptyState').addClass('d-none');
                $('#previewTableContainer').addClass('d-none');
                $('#previewLoading').removeClass('d-none');
                $('#btnPreview').prop('disabled', true);

                $.ajax({
                    url: previewUrl,
                    type: 'POST',
                    data: {
                        loanAmount: loanAmount,
                        tenorMonths: tenor,
                        __RequestVerificationToken: EC.token()
                    },
                    success: function (res) {
                        $('#previewLoading').addClass('d-none');
                        $('#btnPreview').prop('disabled', false);

                        if (!res.status || !res.data) {
                            $('#previewEmptyState').removeClass('d-none');
                            EC.toast('error', res.message || 'Gagal menghitung simulasi cicilan', 'Error');
                            return;
                        }

                        var tbody = $('#previewTbody');
                        tbody.empty();

                        var totalNominal = 0;
                        $.each(res.data, function (idx, item) {
                            totalNominal += item.installmentAmount;
                            var dueDate = new Date(item.dueDate).toLocaleDateString('id-ID', {
                                day: '2-digit', month: 'short', year: 'numeric'
                            });

                            tbody.append(
                                '<tr>' +
                                '<td class="mono">#' + item.installmentNo + '</td>' +
                                '<td>' + dueDate + '</td>' +
                                '<td class="text-end mono">Rp ' + item.installmentAmount.toLocaleString('id-ID') + '</td>' +
                                '<td><span class="badge-status is-pending">' + item.status + '</span></td>' +
                                '</tr>'
                            );
                        });

                        $('#previewSummary').text(
                            'Tenor: ' + tenor + ' bulan | Cicilan: Rp ' + 
                            (res.data[0] ? res.data[0].installmentAmount.toLocaleString('id-ID') : '0') + 
                            '/bulan'
                        );

                        $('#previewTableContainer').removeClass('d-none');
                        EC.toast('success', 'Simulasi cicilan berhasil dimuat.', 'Sukses');
                    },
                    error: function () {
                        $('#previewLoading').addClass('d-none');
                        $('#btnPreview').prop('disabled', false);
                        $('#previewEmptyState').removeClass('d-none');
                        EC.toast('error', 'Gagal menghubungi server.', 'Error');
                    }
                });
            });
        });
    </script>
}

